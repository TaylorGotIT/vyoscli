#!/bin/sh /etc/rc.common
# Copyright (C) 2026 vyoscli
#
# vyoscli has no long-running daemon: it is an interactive CLI plus a config
# store. This init script therefore only guarantees the config directory
# exists at boot; `commit` is what drives UCI/netifd.
START=99
STOP=10

boot() {
	[ -d /etc/vyoscli ] || mkdir -p /etc/vyoscli
}

start() {
	boot
}

stop() {
	:
}
